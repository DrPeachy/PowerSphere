{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PowerSphere",
  "version": "0.1.0",
  "identifier": "com.drpeachy.powersphere",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PowerSphere",
        "width": 100,
        "height": 100,
        "x": 80,
        "y": 160,
        "minWidth": 72,
        "minHeight": 72,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": true,
        "fullscreen": false,
        "focus": false,
        "focusable": true,
        "transparent": true,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "center": false,
        "dragDropEnabled": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "DrPeachy",
    "shortDescription": "浮动球体启动器",
    "longDescription": "PowerSphere 是一个常驻在桌面上的浮动球体启动器，用来打开路径、网址和命令。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
